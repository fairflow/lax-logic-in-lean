/.lake
LaxLogic/Verso_manual.pdf
*.code-workspace
.claude/settings.local.json
.dep/

# scripts/md2eml.py output — regenerable mail drafts, don't track
# (the Message-ID and Date change on every run).
*.eml

# The FRJ-modal paper's build products.  The PDF is regenerable from the
# .tex plus the Lean sources it lists; the sources are the record.
paper/frj-modal/*.pdf
paper/frj-modal/*.aux
paper/frj-modal/*.log
paper/frj-modal/*.out
paper/frj-modal/*.toc
paper/frj-modal/*.fls
paper/frj-modal/*.fdb_latexmk

# Python bytecode caches (never source; one was committed at fe2726c)
__pycache__/
*.pyc

# challenge.py compiles candidates through a temp file at the repo root; a
# killed run leaves one behind.  `_`-prefixed files are scratch probes run
# against the toolkit; one was committed by mistake at dd629c5.
tmp*.lean
_*.lean
/_out/
blueprint/
generalPapers/AiML26-Arxiv.pdf
generalPapers/mendler-et-al-ckd.pdf
generalPapers/qckd.pdf
