#!/bin/sh
# Refuse to push an EPHEMERAL branch name to the remote.
#
# Claude Code names worktree branches `claude/<slug>-<hash>`; pushing those
# clutters the remote with branches that die with the worktree.  Durable lines
# of development get human-chosen names with no hash (`frj-dev`, `ljfo-dev`, …)
# and sessions push with an explicit refspec:
#
#     git push origin HEAD:frj-dev
#
# Escape hatch, for the rare deliberate case:
#     LAXLOGIC_ALLOW_EPHEMERAL_PUSH=1 git push …
#
# Installed by scripts/install-hooks.sh.  Worktrees share the common git dir,
# so this covers every worktree of the clone.

[ "$LAXLOGIC_ALLOW_EPHEMERAL_PUSH" = "1" ] && exit 0

status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    "") continue ;;
  esac
  # a DELETE (all-zero local sha) is always allowed: tidying up ephemeral
  # branches is the whole point.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  case "$remote_ref" in
    refs/heads/claude/*|refs/heads/worktree-*|refs/heads/agent-*)
      printf '\npre-push: refusing to create/update %s\n' "$remote_ref" >&2
      status=1 ;;
    *)
      # a trailing -<6+ hex> is a generated suffix
      case "$remote_ref" in
        *-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])
          printf '\npre-push: refusing to create/update %s (generated suffix)\n' \
            "$remote_ref" >&2
          status=1 ;;
      esac ;;
  esac
done

if [ "$status" -ne 0 ]; then
  cat >&2 <<'MSG'

  Ephemeral branch names are local-only.  Push to a durable campaign
  branch with an explicit refspec instead, e.g.

      git push origin HEAD:frj-dev

  (scripts/campaign-push.sh frj-dev does the fast-forward check first.)
MSG
fi
exit $status
