/-! ## Lemma (a): the relativisation lemma

For any base `b` and generators `x` with `b ≤ x a` semantically, every
`relB`-image holds wherever `b` holds (`force_relB_of_b`), so the value of a
`relB`-image at a world refuting `b` depends only on the worlds refuting `b`.
The general form (`relB_transfer`) is stated for a map `φ : K → M` from a
Kripke model `K` onto the `b`-refuting part above its image: monotone, back
(every successor of `φ k` either forces `b` or is `φ j` for some `j ≥ k`), and
reading the valuation of `K` off the generators.  Then for ◯-free `A` in the
variables `pvar 0, …, pvar (n-1)`,

    φ k ⊩_M relB b x A   ⟺   k ⊩_K A.

`ZL.transfer` of `wip/f0FreeHAn.lean` is the one-variable instance with the
map running the other way (a p-morphism onto the ladder skeleton).  The
instance `φ = Subtype.val` on the restriction `R_b = {v : v ⊮ b}` with
`V a = {v : v ⊩ x a}` (`restrict`) is the lemma as briefed
(`relB_restrict`); it gives the direction `⟹` of `FreePair`
(`relB_preserves`), by soundness on `R_b` and completeness for finite models. -/

section Relativisation

variable (M : SubframeModel) (b : PLLFormula) (x : String → PLLFormula)

/-- **Every `relB`-image holds where `b` holds**, given `b ≤ x a` at every world. -/
theorem force_relB_of_b (hbx : ∀ v a, M.force v b → M.force v (x a)) :
    ∀ (A : PLLFormula) (v : M.W), M.force v b → M.force v (relB b x A)
  | .prop a, v, hv => hbx v a hv
  | .falsePLL, _, hv => hv
  | .and A B, v, hv => ⟨force_relB_of_b hbx A v hv, force_relB_of_b hbx B v hv⟩
  | .or A _, v, hv => Or.inl (force_relB_of_b hbx A v hv)
  | .ifThen _ B, _, hv => fun u hu _ =>
      force_relB_of_b hbx B u (SubframeModel.force_mono M b hu hv)
  | .somehow A, _, hv => fun u hu _ =>
      force_relB_of_b hbx A u (SubframeModel.force_mono M b hu hv)

/-- The atoms of a formula with `varsBelow n` are among `pvar 0, …, pvar (n-1)`. -/
theorem varsBelow_prop {n : Nat} {a : String} (h : varsBelow n (.prop a) = true) :
    ∃ i, i < n ∧ a = pvar i := by
  have h' : ((List.range n).any fun i => decide (a = pvar i)) = true := h
  obtain ⟨i, hi, ha⟩ := List.any_eq_true.mp h'
  exact ⟨i, List.mem_range.mp hi, of_decide_eq_true ha⟩

/-- **The relativisation lemma**, general form: for a map `φ` from a Kripke
model `K` into `M` with image refuting `b`, monotone, with the back condition
relative to `b`, and reading the valuation of `K` off the generators, the
`relB`-image of a ◯-free formula over `pvar 0, …, pvar (n-1)` holds at `φ k`
iff the formula holds at `k`. -/
theorem relB_transfer (K : SubframeModel) (φ : K.W → M.W) (n : Nat)
    (hbx : ∀ v a, M.force v b → M.force v (x a))
    (hb : ∀ k, ¬ M.force (φ k) b)
    (hmono : ∀ {k j}, K.le k j → M.le (φ k) (φ j))
    (hback : ∀ k v, M.le (φ k) v → M.force v b ∨ ∃ j, K.le k j ∧ φ j = v)
    (hatom : ∀ k i, i < n → (M.force (φ k) (x (pvar i)) ↔ k ∈ K.V (pvar i))) :
    ∀ A : PLLFormula, boxFree A = true → varsBelow n A = true →
      ∀ k, (M.force (φ k) (relB b x A) ↔ K.force k A)
  | .prop a, _, hv, k => by
      obtain ⟨i, hi, rfl⟩ := varsBelow_prop hv
      exact hatom k i hi
  | .falsePLL, _, _, k => ⟨hb k, False.elim⟩
  | .and A B, hf, hv, k => by
      have hf' := Bool.and_eq_true_iff.mp (hf : (boxFree A && boxFree B) = true)
      have hv' := Bool.and_eq_true_iff.mp (hv : (varsBelow n A && varsBelow n B) = true)
      exact and_congr (relB_transfer K φ n hbx hb hmono hback hatom A hf'.1 hv'.1 k)
        (relB_transfer K φ n hbx hb hmono hback hatom B hf'.2 hv'.2 k)
  | .or A B, hf, hv, k => by
      have hf' := Bool.and_eq_true_iff.mp (hf : (boxFree A && boxFree B) = true)
      have hv' := Bool.and_eq_true_iff.mp (hv : (varsBelow n A && varsBelow n B) = true)
      exact or_congr (relB_transfer K φ n hbx hb hmono hback hatom A hf'.1 hv'.1 k)
        (relB_transfer K φ n hbx hb hmono hback hatom B hf'.2 hv'.2 k)
  | .ifThen A B, hf, hv, k => by
      have hf' := Bool.and_eq_true_iff.mp (hf : (boxFree A && boxFree B) = true)
      have hv' := Bool.and_eq_true_iff.mp (hv : (varsBelow n A && varsBelow n B) = true)
      have ihA := relB_transfer K φ n hbx hb hmono hback hatom A hf'.1 hv'.1
      have ihB := relB_transfer K φ n hbx hb hmono hback hatom B hf'.2 hv'.2
      show (∀ v, M.le (φ k) v → M.force v (relB b x A) → M.force v (relB b x B)) ↔
        (∀ j, K.le k j → K.force j A → K.force j B)
      constructor
      · intro h j hj hA
        exact (ihB j).mp (h (φ j) (hmono hj) ((ihA j).mpr hA))
      · intro h v hv hA
        rcases hback k v hv with hvb | ⟨j, hj, rfl⟩
        · exact force_relB_of_b M b x hbx B v hvb
        · exact (ihB j).mpr (h j hj ((ihA j).mp hA))
  | .somehow _, hf, _, _ => nomatch hf

/-- **The restriction `R_b`**: the worlds refuting `b`, the order restricted,
no `S`-points (irrelevant for ◯-free formulas), `V a = {v : v ⊩ x a}`. -/
def restrict : SubframeModel where
  W := {v : M.W // ¬ M.force v b}
  le u v := M.le u.1 v.1
  S := fun _ => False
  V a := {v | M.force v.1 (x a)}
  refl u := M.refl u.1
  trans h₁ h₂ := M.trans h₁ h₂
  hered h hv := SubframeModel.force_mono M _ h hv

/-- **Lemma (a)**, as briefed: at a world `w ⊮ b` of a finite model, the
`relB`-image of a ◯-free `A` holds iff `A` holds at `w` in `R_b`. -/
theorem relB_restrict [FinDec M] (hbx : ∀ v a, M.force v b → M.force v (x a)) (n : Nat) :
    ∀ A : PLLFormula, boxFree A = true → varsBelow n A = true →
      ∀ w : (restrict M b x).W, (M.force w.1 (relB b x A) ↔ (restrict M b x).force w A) :=
  relB_transfer M b x (restrict M b x) Subtype.val n hbx (fun w => w.2) (fun h => h)
    (fun _ v hwv => if hvb : M.force v b then Or.inl hvb else Or.inr ⟨⟨v, hvb⟩, hwv, rfl⟩)
    (fun _ _ _ => Iff.rfl)

end Relativisation

/-- **Preservation** (the direction `⟹`): for a base `b` below every
generator in every model, `[A] ⊢ B` gives `[relB b x A] ⊢ relB b x B` for
◯-free `A`, `B` over `pvar 0, …, pvar (n-1)`. -/
theorem relB_preserves (b : PLLFormula) (x : String → PLLFormula) (n : Nat)
    (hbx : ∀ (M : SubframeModel) v a, M.force v b → M.force v (x a))
    {A B : PLLFormula} (hA : boxFree A = true) (hB : boxFree B = true)
    (vA : varsBelow n A = true) (vB : varsBelow n B = true) (hd : Deriv [A] B) :
    Deriv [relB b x A] (relB b x B) := by
  obtain ⟨d⟩ := hd
  have hsem : ∀ (M : SubframeModel) [FinDec M] (v : M.W),
      M.force v (relB b x A) → M.force v (relB b x B) := by
    intro M _ v hv
    rcases Decidable.em (M.force v b) with hvb | hvb
    · exact force_relB_of_b M b x (hbx M) B v hvb
    · have hA' := (relB_restrict M b x (hbx M) n A hA vA ⟨v, hvb⟩).mp hv
      exact (relB_restrict M b x (hbx M) n B hB vB ⟨v, hvb⟩).mpr
        (SubframeModel.CF.soundness₁ d (restrict M b x) ⟨v, hvb⟩ hA')
  have h2 : Deriv [] ((relB b x A).ifThen (relB b x B)) :=
    SubframeModel.CF.completeness_imp hsem
  exact Deriv.impElim (h2.rename fun _ h => absurd h List.not_mem_nil) (Deriv.iden (.head _))

/-- `σ²⊥ ≤ xs a` at every world of every model. -/
theorem b2_le_xs_sem (M : SubframeModel) (v : M.W) (a : String) (hv : M.force v b2) :
    M.force v (xs a) := by
  unfold xs
  split
  · exact Or.inl hv
  · exact fun u hu _ => SubframeModel.force_mono M b2 hu hv

/-- **`FreePair`, direction `⟹`.** -/
theorem freePair_preserves {A B : PLLFormula} (hA : boxFree A = true) (hB : boxFree B = true)
    (vA : varsBelow 2 A = true) (vB : varsBelow 2 B = true) (hd : Deriv [A] B) :
    Deriv [relB b2 xs A] (relB b2 xs B) :=
  relB_preserves b2 xs 2 b2_le_xs_sem hA hB vA vB hd

/-! ## Stage 2 (c): the gadget, its design validated on the four cells

The gadget `M(K)` over a finite Kripke model `K` on `p = pvar 0`,
`q = pvar 1` (design in `wip/f0FreePair-STATUS.md`): worlds `e`, `n` (tops),
`f`, `g`, `h` (the shell: they refute `t3` and force `σ²⊥`), and `w_k` for
`k ∈ K`;

    w_j ≤ w_k ⟺ j ≤ k;   w_k ≤ e, n, f, g;   w_k ≤ h ⟺ k ⊮ q;
    f ≤ e, n;   g ≤ e;   h ≤ e, n;
    S = {n, g, h} ∪ {w_k : k ⊮ p}.

Below: the gadget over the IPC countermodel of each cell, as a `SubCM` table
(worlds `0 = e, 1 = n, 2 = f, 3 = g, 4 = h`, then `w_k`, root `w₀`),
kernel-checked to refute the image: the design's existentials realised on the
four designed cells (METHOD.md §3), before the general proof. -/

/-- The gadget over `k₀ < k₁`, `q` at `k₁`, `p` nowhere, refutes `relB C1`. -/
theorem gadget_C1 : ¬ Deriv [] (relB b2 xs C1) :=
  SubTab.no.verdict (relB b2 xs C1)
    { n := 7, root := 5,
      le := [[true, false, false, false, false, false, false],
             [false, true, false, false, false, false, false],
             [true, true, true, false, false, false, false],
             [true, false, false, true, false, false, false],
             [true, true, false, false, true, false, false],
             [true, true, true, true, true, true, true],
             [true, true, true, true, false, false, true]],
      S := [false, true, false, true, true, true, true], val := [[], [], [], [], [], [], []] }

/-- The gadget over the fork `k₀ < k₁, k₂`, `q` at `k₁`, `p` nowhere, refutes
`relB C2`. -/
theorem gadget_C2 : ¬ Deriv [] (relB b2 xs C2) :=
  SubTab.no.verdict (relB b2 xs C2)
    { n := 8, root := 5,
      le := [[true, false, false, false, false, false, false, false],
             [false, true, false, false, false, false, false, false],
             [true, true, true, false, false, false, false, false],
             [true, false, false, true, false, false, false, false],
             [true, true, false, false, true, false, false, false],
             [true, true, true, true, true, true, true, true],
             [true, true, true, true, false, false, true, false],
             [true, true, true, true, true, false, false, true]],
      S := [false, true, false, true, true, true, true, true], val := [[], [], [], [], [], [], [], []] }

/-- The gadget over the fork, `p` at `k₁`, `q` at `k₂`, refutes `relB C3`. -/
theorem gadget_C3 : ¬ Deriv [] (relB b2 xs C3) :=
  SubTab.no.verdict (relB b2 xs C3)
    { n := 8, root := 5,
      le := [[true, false, false, false, false, false, false, false],
             [false, true, false, false, false, false, false, false],
             [true, true, true, false, false, false, false, false],
             [true, false, false, true, false, false, false, false],
             [true, true, false, false, true, false, false, false],
             [true, true, true, true, true, true, true, true],
             [true, true, true, true, true, false, true, false],
             [true, true, true, true, false, false, false, true]],
      S := [false, true, false, true, true, true, false, true], val := [[], [], [], [], [], [], [], []] }

/-- The gadget over `k₀ < k₁`, `p` at `k₁`, `q` everywhere, refutes `relB C4`. -/
theorem gadget_C4 : ¬ Deriv [] (relB b2 xs C4) :=
  SubTab.no.verdict (relB b2 xs C4)
    { n := 7, root := 5,
      le := [[true, false, false, false, false, false, false],
             [false, true, false, false, false, false, false],
             [true, true, true, false, false, false, false],
             [true, false, false, true, false, false, false],
             [true, true, false, false, true, false, false],
             [true, true, true, true, false, true, true],
             [true, true, true, true, false, false, true]],
      S := [false, true, false, true, true, true, false], val := [[], [], [], [], [], [], []] }

/-! ## Stage 2 (c): the gadget over an arbitrary Kripke model, and the reflection -/

/-- `σ²⊥` holds wherever `t3` holds. -/
theorem b2_of_t3 (N : SubframeModel) {x : N.W} (hx : N.force x t3) : N.force x b2 := by
  show _ ∨ N.force x ((PLLFormula.somehow t3).ifThen t3)
  exact Or.inr fun v hv _ => SubframeModel.force_mono N t3 hv hx

namespace Gadget

/-- The worlds of the gadget over a Kripke model with worlds `α`: the tops
`e`, `n`, the shell `f`, `g`, `h`, and a copy `w k` of each world `k`. -/
inductive Pt (α : Type) where
  | e | n | f | g | h
  | w (k : α)

variable (K : SubframeModel)

/-- The order of the gadget: `w_j ≤ w_k ⟺ j ≤ k`; `w_k ≤ e, n, f, g`;
`w_k ≤ h ⟺ k ⊮ q`; `f ≤ e, n`; `g ≤ e`; `h ≤ e, n`; reflexive. -/
def Le : Pt K.W → Pt K.W → Prop
  | .w j, .w k => K.le j k
  | .w _, .e => True
  | .w _, .n => True
  | .w _, .f => True
  | .w _, .g => True
  | .w j, .h => j ∉ K.V (pvar 1)
  | .f, .e => True
  | .f, .n => True
  | .f, .f => True
  | .g, .e => True
  | .g, .g => True
  | .h, .e => True
  | .h, .n => True
  | .h, .h => True
  | .e, .e => True
  | .n, .n => True
  | _, _ => False

/-- `S = {n, g, h} ∪ {w_k : k ⊮ p}`. -/
def SP : Pt K.W → Prop
  | .e => False
  | .n => True
  | .f => False
  | .g => True
  | .h => True
  | .w k => k ∉ K.V (pvar 0)

theorem Le.refl : ∀ a : Pt K.W, Le K a a
  | .e => trivial
  | .n => trivial
  | .f => trivial
  | .g => trivial
  | .h => trivial
  | .w k => K.refl k

theorem Le.trans {a b c : Pt K.W} (h₁ : Le K a b) (h₂ : Le K b c) : Le K a c := by
  cases a <;> cases b <;> cases c <;>
    first
    | exact True.intro
    | exact False.elim h₁
    | exact False.elim h₂
    | exact K.trans h₁ h₂
    | exact h₁
    | exact fun hj => h₂ (K.hered h₁ hj)

/-- **The gadget model `M(K)`**; no atoms. -/
def MK : SubframeModel where
  W := Pt K.W
  le := Le K
  S := SP K
  V _ := fun _ => False
  refl := Le.refl K
  trans h₁ h₂ := Le.trans K h₁ h₂
  hered _ h := False.elim h

variable {K}

/-! ### The tops -/

theorem e_e : (MK K).force Pt.e e := by
  show ∀ v, (MK K).le Pt.e v → v ∈ (MK K).S → (MK K).force v .falsePLL
  intro v hv hS
  cases v <;> first | exact False.elim hv | exact False.elim hS

theorem n_not_e : ¬ (MK K).force Pt.n e := fun h => h Pt.n trivial trivial

theorem n_ne : (MK K).force Pt.n ne := by
  show ∀ v, (MK K).le Pt.n v → (MK K).force v e → (MK K).force v .falsePLL
  intro v hv he
  cases v <;> first | exact False.elim hv | exact n_not_e he

theorem e_t3 : (MK K).force Pt.e t3 := Or.inl e_e

theorem n_t3 : (MK K).force Pt.n t3 := Or.inr n_ne

theorem e_t4 : (MK K).force Pt.e t4 := by
  show ∀ v, (MK K).le Pt.e v → (MK K).force v t3 → (MK K).force v e
  intro v hv _
  cases v <;> first | exact False.elim hv | exact e_e

theorem n_not_t4 : ¬ (MK K).force Pt.n t4 := fun h => n_not_e (h Pt.n trivial n_t3)

theorem n_Y : (MK K).force Pt.n Yf := by
  refine Or.inr ?_
  show ∀ v, (MK K).le Pt.n v → (MK K).force v t4 → (MK K).force v .falsePLL
  intro v hv ht
  cases v <;> first | exact False.elim hv | exact n_not_t4 ht

/-! ### The shell `f`, `g`, `h`: each refutes `t3` and forces `σ²⊥` -/

/-- A world with an `S`-world and `e` above it refutes `t3`. -/
theorem not_t3_of {x : Pt K.W} (hS : ∃ s, (MK K).le x s ∧ s ∈ (MK K).S)
    (he : (MK K).le x Pt.e) : ¬ (MK K).force x t3 := by
  intro ht
  have ht' : (MK K).force x e ∨ (MK K).force x ne := ht
  rcases ht' with h | h
  · obtain ⟨s, hs, hsS⟩ := hS
    exact h s hs hsS
  · exact h Pt.e he e_e

theorem f_not_t3 : ¬ (MK K).force Pt.f t3 := not_t3_of ⟨Pt.n, trivial, trivial⟩ trivial

theorem g_not_t3 : ¬ (MK K).force Pt.g t3 := not_t3_of ⟨Pt.g, trivial, trivial⟩ trivial

theorem h_not_t3 : ¬ (MK K).force Pt.h t3 := not_t3_of ⟨Pt.h, trivial, trivial⟩ trivial

/-- `f ⊩ ◯t3`: the only `S`-world above `f` is `n`. -/
theorem f_c1 : (MK K).force Pt.f (.somehow t3) := by
  show ∀ v, (MK K).le Pt.f v → v ∈ (MK K).S → (MK K).force v t3
  intro v hv hS
  cases v <;> first | exact False.elim hv | exact False.elim hS | exact n_t3

theorem f_b2 : (MK K).force Pt.f b2 := by
  show (MK K).force Pt.f (.somehow t3) ∨ _
  exact Or.inl f_c1

theorem g_b2 : (MK K).force Pt.g b2 := by
  show _ ∨ (MK K).force Pt.g ((PLLFormula.somehow t3).ifThen t3)
  refine Or.inr ?_
  show ∀ v, (MK K).le Pt.g v → (MK K).force v (.somehow t3) → (MK K).force v t3
  intro v hv hc
  cases v <;> first
    | exact False.elim hv
    | exact e_t3
    | exact absurd (hc Pt.g trivial trivial) g_not_t3

theorem h_b2 : (MK K).force Pt.h b2 := by
  show _ ∨ (MK K).force Pt.h ((PLLFormula.somehow t3).ifThen t3)
  refine Or.inr ?_
  show ∀ v, (MK K).le Pt.h v → (MK K).force v (.somehow t3) → (MK K).force v t3
  intro v hv hc
  cases v <;> first
    | exact False.elim hv
    | exact e_t3
    | exact n_t3
    | exact absurd (hc Pt.h trivial trivial) h_not_t3

/-- `f ⊩ ◯Y`: the only `S`-world above `f` is `n`, and `n ⊩ ¬t4`. -/
theorem f_x : (MK K).force Pt.f xf := by
  show ∀ v, (MK K).le Pt.f v → v ∈ (MK K).S → (MK K).force v Yf
  intro v hv hS
  cases v <;> first | exact False.elim hv | exact False.elim hS | exact n_Y

theorem g_t4 : (MK K).force Pt.g t4 := by
  show ∀ v, (MK K).le Pt.g v → (MK K).force v t3 → (MK K).force v e
  intro v hv ht
  cases v <;> first | exact False.elim hv | exact e_e | exact absurd ht g_not_t3

/-- `g ⊩ ◯Y`: the only `S`-world above `g` is `g`, and `g ⊩ t4`. -/
theorem g_x : (MK K).force Pt.g xf := by
  show ∀ v, (MK K).le Pt.g v → v ∈ (MK K).S → (MK K).force v Yf
  intro v hv hS
  cases v <;> first | exact False.elim hv | exact False.elim hS | exact Or.inl g_t4

/-- `h ⊮ ◯Y`: `h ∈ S`, `h ⊮ t4` (by `n`), `h ⊮ ¬t4` (by `e`). -/
theorem h_not_x : ¬ (MK K).force Pt.h xf := by
  intro hx
  have hY : (MK K).force Pt.h t4 ∨ (MK K).force Pt.h (t4.ifThen .falsePLL) :=
    hx Pt.h trivial trivial
  rcases hY with ht | hn
  · exact n_not_e (ht Pt.n trivial n_t3)
  · exact hn Pt.e trivial e_t4

/-- `h ⊩ ◯Y ↠ t3`. -/
theorem h_xt3 : (MK K).force Pt.h (xf.ifThen t3) := by
  show ∀ v, (MK K).le Pt.h v → (MK K).force v xf → (MK K).force v t3
  intro v hv hx
  cases v <;> first
    | exact False.elim hv
    | exact e_t3
    | exact n_t3
    | exact absurd hx h_not_x

/-! ### The copies `w_k` of `K` -/

/-- **`w_k ⊮ σ²⊥`**: `◯t3` fails by `g`, `◯t3 ↠ t3` fails by `f`. -/
theorem w_not_b2 (k : K.W) : ¬ (MK K).force (Pt.w k) b2 := by
  intro hb
  have hb' : (MK K).force (Pt.w k) (.somehow t3) ∨
      (MK K).force (Pt.w k) ((PLLFormula.somehow t3).ifThen t3) := hb
  rcases hb' with hc | hg
  · exact g_not_t3 (hc Pt.g trivial trivial)
  · exact f_not_t3 (hg Pt.f trivial f_c1)

/-- The back condition: every successor of `w_k` forces `σ²⊥` or is a `w_j`, `j ≥ k`. -/
theorem w_back (k : K.W) (v : Pt K.W) (hv : (MK K).le (Pt.w k) v) :
    (MK K).force v b2 ∨ ∃ j, K.le k j ∧ Pt.w j = v := by
  cases v with
  | e => exact Or.inl (b2_of_t3 _ e_t3)
  | n => exact Or.inl (b2_of_t3 _ n_t3)
  | f => exact Or.inl f_b2
  | g => exact Or.inl g_b2
  | h => exact Or.inl h_b2
  | w j => exact Or.inr ⟨j, hv, rfl⟩

variable [FinDec K]

/-- **`x₀` reads `p`**: `w_k ⊩ ◯σ²⊥ ⟺ k ⊩ p`. -/
theorem w_x0 (k : K.W) : (MK K).force (Pt.w k) x0 ↔ k ∈ K.V (pvar 0) := by
  constructor
  · intro hx
    rcases Decidable.em (k ∈ K.V (pvar 0)) with hk | hk
    · exact hk
    · exact absurd (hx (Pt.w k) (K.refl k) hk) (w_not_b2 k)
  · intro hk
    show ∀ v, (MK K).le (Pt.w k) v → v ∈ (MK K).S → (MK K).force v b2
    intro v hv hS
    cases v with
    | e => exact False.elim hS
    | n => exact b2_of_t3 _ n_t3
    | f => exact False.elim hS
    | g => exact g_b2
    | h => exact h_b2
    | w j =>
        have hv' : K.le k j := hv
        exact absurd (K.hered hv' hk) hS

/-- **`x₁` reads `q`**: `w_k ⊩ σ²⊥ ∨ ((◯Y ↠ t3) ↠ t3) ⟺ k ⊩ q`. -/
theorem w_x1 (k : K.W) : (MK K).force (Pt.w k) x1 ↔ k ∈ K.V (pvar 1) := by
  constructor
  · intro hx
    rcases Decidable.em (k ∈ K.V (pvar 1)) with hk | hk
    · exact hk
    · exfalso
      have hx' : (MK K).force (Pt.w k) b2 ∨
          (MK K).force (Pt.w k) ((xf.ifThen t3).ifThen t3) := hx
      rcases hx' with hb | hd
      · exact w_not_b2 k hb
      · exact h_not_t3 (hd Pt.h hk h_xt3)
  · intro hk
    show _ ∨ (MK K).force (Pt.w k) ((xf.ifThen t3).ifThen t3)
    refine Or.inr ?_
    show ∀ v, (MK K).le (Pt.w k) v → (MK K).force v (xf.ifThen t3) → (MK K).force v t3
    intro v hv hxt
    cases v with
    | e => exact e_t3
    | n => exact n_t3
    | f => exact absurd (hxt Pt.f trivial f_x) f_not_t3
    | g => exact absurd (hxt Pt.g trivial g_x) g_not_t3
    | h => exact absurd hk hv
    | w _ => exact absurd (hxt Pt.f trivial f_x) f_not_t3

/-- The generators read the valuation of `K`. -/
theorem w_atom (k : K.W) : ∀ i, i < 2 →
    ((MK K).force (Pt.w k) (xs (pvar i)) ↔ k ∈ K.V (pvar i))
  | 0, _ => by rw [xs_p0]; exact w_x0 k
  | 1, _ => by rw [xs_p1]; exact w_x1 k
  | i + 2, hi => absurd hi (Nat.not_lt_of_le (Nat.le_add_left 2 i))

/-- **The gadget transfer**: for ◯-free `A` over `p`, `q`,

    w_k ⊩_{M(K)} relB σ²⊥ xs A   ⟺   k ⊩_K A. -/
theorem transfer : ∀ A : PLLFormula, boxFree A = true → varsBelow 2 A = true →
    ∀ k : K.W, ((MK K).force (Pt.w k) (relB b2 xs A) ↔ K.force k A) :=
  relB_transfer (MK K) b2 xs K Pt.w 2 (b2_le_xs_sem (MK K)) w_not_b2 (fun h => h)
    w_back w_atom

end Gadget

/-- **`FreePair`, direction `⟸`** (faithfulness): a derivation of the images
gives `[A] ⊢ B`, by the gadget over every finite Kripke model. -/
theorem freePair_reflects {A B : PLLFormula} (hA : boxFree A = true) (hB : boxFree B = true)
    (vA : varsBelow 2 A = true) (vB : varsBelow 2 B = true)
    (hd : Deriv [relB b2 xs A] (relB b2 xs B)) : Deriv [A] B := by
  obtain ⟨d⟩ := hd
  have hsem : ∀ (K : SubframeModel) [FinDec K] (k : K.W), K.force k A → K.force k B := by
    intro K _ k hk
    exact (Gadget.transfer B hB vB k).mp
      (SubframeModel.CF.soundness₁ d (Gadget.MK K) (Gadget.Pt.w k)
        ((Gadget.transfer A hA vA k).mpr hk))
  have h2 : Deriv [] (A.ifThen B) := SubframeModel.CF.completeness_imp hsem
  exact Deriv.impElim (h2.rename fun _ h => absurd h List.not_mem_nil) (Deriv.iden (.head _))

/-- **PROVED: `FreePair`.**  `x₀ = ◯σ²⊥` and `x₁ = σ²⊥ ∨ ((◯Y ↠ t3) ↠ t3)`
freely generate a copy of `H₂` in `[σ²⊥, ⊤]`. -/
theorem freePair : FreePair := fun _ _ hA hB vA vB =>
  ⟨freePair_preserves hA hB vA vB, freePair_reflects hA hB vA vB⟩

/-- **PROVED: `[σ²⊥, ⊤]` contains the free Heyting algebra on two generators**
(with bottom `σ²⊥` and F0's `∧`, `∨`, `↠`). -/
theorem freeHAnAbove_base2_two : FreeHAnAbove (base 2) 2 := freeHAn_of_freePair freePair

end Pair
end F0
end PLLND

