namespace F0

open RNEmbed

/-- `g3 ⊬ g1 ∨ g5` (the certificate's formula is `g3 ↠ (g1 ∨ g5)` written out). -/
theorem cellA_refuted : [gap 3] ⊬ (gap 1).or (gap 5) :=
