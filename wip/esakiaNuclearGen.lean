/-!
# Nuclear Esakia duality, the general case, and the bridge to the library's
# semantics: STATEMENTS ONLY (round 1)

Every statement here is a `def … : Prop` and is OPEN.  Nothing is proved.
Definitions that carry proof fields (`Spec`'s order, `omegaChain`) carry only
one-line proofs.

## Part G: Esakia duality for nuclear Heyting algebras

Transcribed from Ávila–Bezhanishvili–Morandi–Zaldívar, *When is the frame of
nuclei spatial: a new approach*, J. Pure Appl. Algebra 224 (2020) 106302,
arXiv:1906.03636 (**[ABMZ]**): Def 3.1 (Priestley space), Def 3.4 (Esakia
space), Thm 3.5 (Esakia duality), Def 4.1 (nuclear subset), and Thms 4.3,
4.4, which restate Bezhanishvili–Ghilardi, APAL 147 (2007) 84–100
(**[BG]**) Thm 30 and Thm 34; [BG] Cor 31 as quoted in [ABMZ] §4.

Divergences, recorded when made:
* D1. Mathlib's `PriestleySpace` omits compactness; `IsEsakiaSpace` adds
  `CompactSpace` explicitly ([ABMZ] Def 3.1 has it).
* D2. The spectrum's topology is generated by the subbasis
  `{φ(a)} ∪ {φ(a)ᶜ}` rather than the basis `{φ(a) ∖ φ(b)}` of [ABMZ] §3;
  the two generate the same topology because `φ(a) ∖ φ(b) = φ(a) ∩ φ(b)ᶜ`
  and `φ` preserves finite meets.
* D3. [ABMZ] writes `N_j = {x | j⁻¹(x) = x}`; transcribed literally as
  `⇑j ⁻¹' x = x`.
* D4. [BG] Thm 34(3) "`max`" is transcribed as the set of points of
  `(φ a)ᶜ` with no strictly larger point in `(φ a)ᶜ`.
* D5. The nuclei of Cor 31 and Thm 34 (`⊥`, `⊤`, `j ⊓ k`, `u_a`, `v_a`,
  `w_a`) are named by their values (`∀ x, j x = …`), not by Mathlib's
  instances: `Nucleus.instBot` and `Nucleus.instMin` reach
  `Classical.choice` (through `Nucleus.le_apply`, measured with
  `#axiom_path`), which would make the statements themselves classical.

Where `Classical.choice` will enter (when proved): the prime filter theorem
(for `φ` injective, the Esakia condition, and `N_j` nuclear), and
compactness of the spectrum (Alexander's subbasis theorem,
`isCompact_generateFrom`).  The finite case (`wip/esakiaNuclearFin.lean`)
needs neither.

## Part R: the bridge to constraint models and subframe models

Statements of OURS relating the dual of a nuclear Heyting algebra to the
library's `PLLND.ConstraintModel` (Fairtlough–Mendler 1997, Defs 3.1–3.2,
`LaxLogic/PLL/Semantics/Kripke.lean`) and `PLLND.SubframeModel`
(`LaxLogic/PLL/Semantics/Subframe.lean`).  In words:

* R1: the `◯`-clause of a subframe model IS the dual nucleus of [BBCGGJ]/[BG],
  `j_S(U) = X ∖ ↓(S ∖ U)`, and it is a nucleus on the hereditary sets of any
  preorder.
* R2: the `◯`-clause of a constraint model is a nucleus `j_C` on the
  hereditary sets containing `F`: every constraint model has a complex
  algebra `(H_C, j_C)`, a nuclear Heyting algebra.
* R3: for antisymmetric `Rᵢ`, the meet-prime `W ∖ ↓w` of a non-fallible world
  is fixed by `j_C` iff `w` is `Rₘ`-final (R3a); for finite models every
  meet-prime is of that form (R3b), ordered dually to `Rᵢ` (R3c), so for
  finite `C` with antisymmetric `Rᵢ` the dual `S`-poset of `(H_C, j_C)` is
  exactly the library's `C.toSubframe`.
* R4: `toSubframe ∘ toConstraint` is the identity on `S`: `some x` is
  `Rₘ`-final in `M.toConstraint` iff `x ∈ M.S`.
* R5: the designed infinite cell.  On `ω` with `Rᵢ = Rₘ = ≤` and no fallible
  worlds, no world is `Rₘ`-final and no `S ⊆ ω` gives `j_C` as `j_S`, but the
  non-principal prime filter `x_∞` of `H_C` is fixed by `j_C`: the
  `S`-point exists only in the Esakia dual.  This is the precise sense of the
  remark in `Subframe.lean` that infinite constraint models need not have
  `Rₘ`-final points.
-/

namespace EsakiaNuclear.Gen

open Set

/-! ## G.0 Esakia spaces and nuclear subsets -/

/-- An Esakia space ([ABMZ] Defs 3.1, 3.4): a compact Priestley space (D1)
in which the down-set of every clopen set is clopen. -/
def IsEsakiaSpace (X : Type*) [TopologicalSpace X] [PartialOrder X] : Prop :=
  CompactSpace X ∧ PriestleySpace X ∧
  ∀ U : Set X, IsClopen U → IsClopen (lowerClosure U : Set X)

/-- A nuclear subset ([ABMZ] Def 4.1(1); "subframe" in [BG]): a closed set
`N` such that `↓(U ∩ N)` is clopen for every clopen `U`. -/
def IsNuclear {X : Type*} [TopologicalSpace X] [PartialOrder X] (N : Set X) : Prop :=
  IsClosed N ∧ ∀ U : Set X, IsClopen U → IsClopen (lowerClosure (U ∩ N) : Set X)

/-! ## G.1 The prime filter spectrum of a Heyting algebra -/

variable {A : Type*} [HeytingAlgebra A]

/-- A prime filter. -/
structure IsPrimeFilter (x : Set A) : Prop where
  top_mem : ⊤ ∈ x
  bot_not_mem : ⊥ ∉ x
  mem_of_le : ∀ {a b : A}, a ≤ b → a ∈ x → b ∈ x
  inf_mem : ∀ {a b : A}, a ∈ x → b ∈ x → a ⊓ b ∈ x
  mem_or_mem : ∀ {a b : A}, a ⊔ b ∈ x → a ∈ x ∨ b ∈ x

variable (A) in
/-- `X_A`, the prime filters of `A` ([ABMZ] §3). -/
structure Spec where
  carrier : Set A
  isPrime : IsPrimeFilter carrier

/-- Ordered by inclusion.  (Written out rather than lifted from `Set A`,
whose Mathlib order instance reaches `Classical.choice`.) -/
instance : PartialOrder (Spec A) where
  le x y := x.carrier ⊆ y.carrier
  le_refl _ := fun _ h => h
  le_trans _ _ _ h₁ h₂ := fun _ h => h₂ (h₁ h)
  le_antisymm x y h₁ h₂ := by
    cases x with
    | mk cx px =>
      cases y with
      | mk cy py =>
        have hc : cx = cy := Set.ext fun _ => ⟨fun h => h₁ h, fun h => h₂ h⟩
        subst hc
        rfl

/-- `φ(a) = {x ∈ X_A | a ∈ x}`. -/
def phi (a : A) : Set (Spec A) := {x | a ∈ x.carrier}

/-- The topology generated by the `φ(a)` and their complements (D2). -/
instance : TopologicalSpace (Spec A) :=
  TopologicalSpace.generateFrom (range (phi (A := A)) ∪ range fun a => (phi (A := A) a)ᶜ)

/-! ## G.2 Statements -/

/-- **G1** at `A` (Esakia 1974; [ABMZ] Thm 3.5, object part): `X_A` is an
Esakia space and `φ` is a Heyting isomorphism of `A` onto the clopen
up-sets, `φ(a → b) = X_A ∖ ↓(φ(a) ∖ φ(b))`. -/
def EsakiaObjects (A : Type*) [HeytingAlgebra A] : Prop :=
  IsEsakiaSpace (Spec A) ∧
  Function.Injective (phi (A := A)) ∧
  (∀ a : A, IsClopen (phi a) ∧ IsUpperSet (phi a)) ∧
  (∀ U : Set (Spec A), IsClopen U → IsUpperSet U → ∃ a, phi a = U) ∧
  (∀ a b : A, phi (a ⊓ b) = phi a ∩ phi b) ∧
  (∀ a b : A, phi (a ⊔ b) = phi a ∪ phi b) ∧
  phi (⊤ : A) = univ ∧ phi (⊥ : A) = ∅ ∧
  (∀ a b : A, phi (a ⇨ b) = (lowerClosure (phi a \ phi b) : Set (Spec A))ᶜ)

/-- **G1.** -/
def G1 : Prop := ∀ (A : Type) [HeytingAlgebra A], EsakiaObjects A

/-- `N_j = {x ∈ X_A | j⁻¹(x) = x}` ([ABMZ] Thm 4.3; D3). -/
def Nj (j : Nucleus A) : Set (Spec A) := {x | ⇑j ⁻¹' x.carrier = x.carrier}

/-- **G2** at `A` ([BG] Thm 30 = [ABMZ] Thm 4.3): the nuclei on `A` are dually
isomorphic to the nuclear subsets of `X_A`.  (i) `N_j` is nuclear; (ii) for
nuclear `N` there is a nucleus `j_N` with `φ(j_N a) = X_A ∖ ↓(N ∖ φ(a))`;
(iii) its `N_{j_N}` is `N`; (iv) `j ↦ N_j` reverses and reflects the order
(hence is injective, so `j_{N_j} = j`). -/
def BGThm30 (A : Type*) [HeytingAlgebra A] : Prop :=
  (∀ j : Nucleus A, IsNuclear (Nj j)) ∧
  (∀ N : Set (Spec A), IsNuclear N →
    ∃ j : Nucleus A, ∀ a, phi (j a) = (lowerClosure (N \ phi a) : Set (Spec A))ᶜ) ∧
  (∀ (j : Nucleus A) (N : Set (Spec A)), IsNuclear N →
    (∀ a, phi (j a) = (lowerClosure (N \ phi a) : Set (Spec A))ᶜ) → Nj j = N) ∧
  (∀ j k : Nucleus A, j ≤ k ↔ Nj k ⊆ Nj j)

/-- **G2.** -/
def G2 : Prop := ∀ (A : Type) [HeytingAlgebra A], BGThm30 A

/-- **G3** at `A` ([BG] Cor 31 as quoted in [ABMZ] §4; D5): the bottom
nucleus (the identity) has `N = X_A`, the top (constantly `⊤`) has `N = ∅`,
and `N_{j ∧ k} = N_j ∪ N_k` for the pointwise meet. -/
def BGCor31 (A : Type*) [HeytingAlgebra A] : Prop :=
  (∀ j : Nucleus A, (∀ x, j x = x) → Nj j = univ) ∧
  (∀ j : Nucleus A, (∀ x, j x = ⊤) → Nj j = ∅) ∧
  ∀ j k m : Nucleus A, (∀ x, m x = j x ⊓ k x) → Nj m = Nj j ∪ Nj k

/-- **G3.** -/
def G3 : Prop := ∀ (A : Type) [HeytingAlgebra A], BGCor31 A

/-- **G4** at `A` ([BG] Thm 34 = [ABMZ] Thm 4.4; D4): the closed, open and
`w`-nuclei. -/
def BGThm34 (A : Type*) [HeytingAlgebra A] : Prop :=
  ∀ (a : A) (j : Nucleus A),
    ((∀ x, j x = a ⊔ x) → Nj j = (phi a)ᶜ) ∧
    ((∀ x, j x = a ⇨ x) → Nj j = phi a) ∧
    ((∀ x, j x = (x ⇨ a) ⇨ a) →
      Nj j = {x | x ∈ (phi a)ᶜ ∧ ∀ y ∈ (phi a)ᶜ, x ≤ y → y = x})

/-- **G4.** -/
def G4 : Prop := ∀ (A : Type) [HeytingAlgebra A], BGThm34 A

end EsakiaNuclear.Gen

/-! ## Part R: the bridge (OURS, OPEN) -/

namespace EsakiaNuclear.Bridge

open Set PLLND PLLFormula

/-- `↓T` in a subframe model. -/
def SubframeModel.down (M : SubframeModel) (T : Set M.W) : Set M.W :=
  {x | ∃ y, M.le x y ∧ y ∈ T}

/-- The dual nucleus of `S`: `j_S(U) = X ∖ ↓(S ∖ U)`. -/
def SubframeModel.jS (M : SubframeModel) (U : Set M.W) : Set M.W :=
  (SubframeModel.down M (M.S \ U))ᶜ

/-- The truth set of `φ`. -/
def SubframeModel.truth (M : SubframeModel) (φ : PLLFormula) : Set M.W :=
  {x | M.force x φ}

/-- Hereditary along a relation. -/
def Hered {W : Type} (le : W → W → Prop) (U : Set W) : Prop :=
  ∀ {x y}, le x y → x ∈ U → y ∈ U

/-- **R1.** The `◯`-clause of a subframe model is `j_S`, and `j_S` is a
nucleus on the hereditary sets of any preorder (the infinite form of F3). -/
def R1 : Prop :=
  (∀ (M : SubframeModel) (φ : PLLFormula),
    SubframeModel.truth M (.somehow φ) = SubframeModel.jS M (SubframeModel.truth M φ)) ∧
  (∀ (M : SubframeModel) (U : Set M.W), Hered M.le U → U ⊆ SubframeModel.jS M U) ∧
  (∀ (M : SubframeModel) (U : Set M.W),
    Hered M.le (SubframeModel.jS M U) ∧
    SubframeModel.jS M (SubframeModel.jS M U) ⊆ SubframeModel.jS M U) ∧
  (∀ (M : SubframeModel) (U V : Set M.W),
    SubframeModel.jS M (U ∩ V) = SubframeModel.jS M U ∩ SubframeModel.jS M V)

/-- The `◯`-clause of a constraint model as an operator on sets:
`j_C(U) = {w | ∀ v, w Rᵢ v → ∃ u, v Rₘ u ∧ u ∈ U}`. -/
def ConstraintModel.jC (C : ConstraintModel) (U : Set C.W) : Set C.W :=
  {w | ∀ v, C.Ri w v → ∃ u, C.Rm v u ∧ u ∈ U}

/-- `H_C`: the hereditary sets containing `F`, the carrier of the complex
algebra of a constraint model. -/
def ConstraintModel.HC (C : ConstraintModel) (U : Set C.W) : Prop :=
  Hered C.Ri U ∧ C.F ⊆ U

/-- **R2.** Every constraint model has a complex algebra `(H_C, j_C)`:
`j_C` maps `H_C` to itself and is a nucleus there, and it interprets `◯`. -/
def R2 : Prop :=
  (∀ (C : ConstraintModel) (φ : PLLFormula),
    {w | C.force w (.somehow φ)} = ConstraintModel.jC C {w | C.force w φ}) ∧
  (∀ (C : ConstraintModel) (U : Set C.W), ConstraintModel.HC C U →
    ConstraintModel.HC C (ConstraintModel.jC C U) ∧ U ⊆ ConstraintModel.jC C U) ∧
  (∀ (C : ConstraintModel) (U : Set C.W),
    ConstraintModel.jC C (ConstraintModel.jC C U) ⊆ ConstraintModel.jC C U) ∧
  (∀ (C : ConstraintModel) (U V : Set C.W), Hered C.Ri U →
    ConstraintModel.jC C (U ∩ V) = ConstraintModel.jC C U ∩ ConstraintModel.jC C V)

/-- `W ∖ ↓w`, the meet-prime of `H_C` at a world (`ε` of [BBCGGJ] (†)). -/
def ConstraintModel.mPt (C : ConstraintModel) (w : C.W) : Set C.W := {u | ¬ C.Ri u w}

/-- A meet-prime of `H_C`. -/
def ConstraintModel.IsMeetPrimeHC (C : ConstraintModel) (m : Set C.W) : Prop :=
  ConstraintModel.HC C m ∧ m ≠ univ ∧
  ∀ U V, ConstraintModel.HC C U → ConstraintModel.HC C V → U ∩ V ⊆ m → U ⊆ m ∨ V ⊆ m

/-- **R3a.** For antisymmetric `Rᵢ`: `W ∖ ↓w` is fixed by `j_C` iff `w` is
`Rₘ`-final (no finiteness needed; for `w ∉ F` it is the meet-prime of `w`). -/
def R3a : Prop :=
  ∀ C : ConstraintModel, (∀ {v w}, C.Ri v w → C.Ri w v → v = w) →
    ∀ w, (ConstraintModel.jC C (ConstraintModel.mPt C w) = ConstraintModel.mPt C w ↔ C.RmFinal w)

/-- **R3b** (◯-free). For finite `C`, every meet-prime of `H_C` is `W ∖ ↓w`
for some `w ∉ F`.  (Infinite models have others: `x_∞` of R5.) -/
def R3b : Prop :=
  ∀ C : ConstraintModel, Finite C.W →
    ∀ m, ConstraintModel.IsMeetPrimeHC C m → ∃ w, w ∉ C.F ∧ m = ConstraintModel.mPt C w

/-- **R3c** (◯-free). For any `C`, `W ∖ ↓w` is a meet-prime of `H_C` for each
`w ∉ F`, and these are ordered dually to `Rᵢ`.  With R3a and R3b, for finite
`C` with antisymmetric `Rᵢ` the dual `S`-poset of `(H_C, j_C)` is
`C.toSubframe` (points `W ∖ F` by `Rᵢ`, `S` the `Rₘ`-final worlds). -/
def R3c : Prop :=
  ∀ C : ConstraintModel,
    (∀ w, w ∉ C.F → ConstraintModel.IsMeetPrimeHC C (ConstraintModel.mPt C w)) ∧
    (∀ v w, ConstraintModel.mPt C v ⊆ ConstraintModel.mPt C w ↔ C.Ri w v)

/-- **R4.** `toSubframe ∘ toConstraint` returns `S`: `some x` is `Rₘ`-final in
`M.toConstraint` iff `x ∈ M.S` (the non-fallible points are the `some x`). -/
def R4 : Prop :=
  ∀ (M : SubframeModel) (x : M.W), (M.toConstraint).RmFinal (some x) ↔ x ∈ M.S

/-- The designed infinite cell: `ω` with `Rᵢ = Rₘ = ≤`, no fallible worlds,
empty valuation. -/
def omegaChain : ConstraintModel where
  W := Nat
  Ri := fun a b => a ≤ b
  Rm := fun a b => a ≤ b
  F := ∅
  V := fun _ => ∅
  refl_i := Nat.le_refl
  trans_i := Nat.le_trans
  refl_m := Nat.le_refl
  trans_m := Nat.le_trans
  sub_mi := id
  hered_F := fun _ h => False.elim h
  hered_V := fun _ h => False.elim h
  full_F := fun h => False.elim h

/-- A prime filter of `H_C`, in set form (`⊥` of `H_C` is `F`). -/
def ConstraintModel.IsPrimeFilterHC (C : ConstraintModel) (x : Set (Set C.W)) : Prop :=
  (∀ U ∈ x, ConstraintModel.HC C U) ∧ univ ∈ x ∧ C.F ∉ x ∧
  (∀ U V, ConstraintModel.HC C V → U ∈ x → U ⊆ V → V ∈ x) ∧
  (∀ U ∈ x, ∀ V ∈ x, U ∩ V ∈ x) ∧
  (∀ U V, ConstraintModel.HC C U → ConstraintModel.HC C V → U ∪ V ∈ x → U ∈ x ∨ V ∈ x)

/-- The non-principal prime filter `x_∞` of `H_{ω}`: the non-empty members. -/
def xInf : Set (Set Nat) := {U | ConstraintModel.HC omegaChain U ∧ U.Nonempty}

/-- **R5.** In `omegaChain`: (a) no world is `Rₘ`-final; (b) no `S ⊆ ω` gives
`j_C` as `j_S(U) = {x | ∀ y ≥ x, y ∈ S → y ∈ U}` on `H_C`; (c) `x_∞` is a
prime filter of `H_C`, fixed by `j_C` (`j_C⁻¹(x_∞) = x_∞`), and not the
principal filter of any world. -/
def R5 : Prop :=
  (∀ w, ¬ omegaChain.RmFinal w) ∧
  (∀ S : Set Nat, ∃ U, ConstraintModel.HC omegaChain U ∧
    {x : Nat | ∀ y, x ≤ y → y ∈ S → y ∈ U} ≠ ConstraintModel.jC omegaChain U) ∧
  ConstraintModel.IsPrimeFilterHC omegaChain xInf ∧
  (∀ U, ConstraintModel.HC omegaChain U → (ConstraintModel.jC omegaChain U ∈ xInf ↔ U ∈ xInf)) ∧
  (∀ w : Nat, xInf ≠ {U | ConstraintModel.HC omegaChain U ∧ w ∈ U})

end EsakiaNuclear.Bridge

