/-- **The ascent is not strict past k = 3**, unconditionally: every later
member of the family is interderivable with `θ₃`. -/
theorem thetaStabilises (n : Nat) :
    Nonempty (LaxND [theta (n + 3)] (theta 3)) ∧
    Nonempty (LaxND [theta 3] (theta (n + 3))) :=
  theta_stab theta4_le_theta3 theta3_le_theta4 n

/-- No countermodel can exist for `θ_{k+1} ⊢ θ_k` past the third rung. -/
theorem thetaNotStrict (n : Nat) :
    Nonempty (LaxND [theta (n + 4)] (theta (n + 3))) :=
  theta_not_strict theta4_le_theta3 theta3_le_theta4 n

