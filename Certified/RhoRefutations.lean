  rmT := [[true, false, false, false, false], [false, true, false, false, false], [false, false, true, true, false], [false, false, false, true, false], [false, false, false, false, true]]
  falT := [false, false, false, true, false]
  atomsT := [[], [], [], [], []]

theorem cm_rho_21_17_ok : cm_rho_21_17.okB = true := by decide
theorem cm_rho_21_17_root : cm_rho_21_17.root < cm_rho_21_17.n := by decide

def K_rho_21_17 : Kripke := cm_rho_21_17.toKripke cm_rho_21_17_ok cm_rho_21_17_root

set_option maxRecDepth 1000000 in
theorem cm_rho_21_17_force :
    ¬ (K_rho_21_17).force (K_rho_21_17).root
        (ofPLL (.ifThen (RhoOrder.rhoF 21) (RhoOrder.rhoF 17))) := by decide

/-- `ρ21 ⊬ ρ17`, one-directional on purpose: a countermodel
establishes exactly this, and `¬ Interd` would lose WHICH direction
failed.  `⊬` is `PLLND.Underivable`, a reducible abbrev for
`¬ Nonempty (LaxND …)`, so the bridge lemma's conclusion unifies with it
unchanged. -/
theorem rho_21_nle_17 :
    [RhoOrder.rhoF 21] ⊬ RhoOrder.rhoF 17 :=
  not_entails_of_countermodel (K_rho_21_17) cm_rho_21_17_force

set_option maxRecDepth 1000000 in
/-- Control: the model still forces `ρ1 = ⊤` — it does not refute by
making everything false. -/
theorem cm_rho_21_17_control :
    (K_rho_21_17).force (K_rho_21_17).root (ofPLL (RhoOrder.rhoF 1)) := by decide

