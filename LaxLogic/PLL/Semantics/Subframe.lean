import LaxLogic.PLL.Semantics.Countermodel

/-!
# Subframe models: `◯φ` is true where `φ` holds at every `S`-point above

A *subframe model* is an intuitionistic Kripke model `(W, ≤, V)` together with
an arbitrary set `S ⊆ W` of points, and

    x ⊩ ◯φ   ⟺   ∀ y ≥ x, y ∈ S → y ⊩ φ.

There are no fallible worlds: `⊥` is forced nowhere, and `◯⊥` holds exactly
where no `S`-point lies above.  This is the subframe reading of a nucleus
(Bezhanishvili–Ghilardi), and it is the special case of Goldblatt's J-spaces
(Goldblatt 1981, recalled in Fairtlough–Mendler 1997 §3) whose covers are
generated by points: `J(w) := {U hereditary | U ⊇ S ∩ ↑w}`, so that "`φ` is
locally true at `w`" reads "`φ` holds at every `S`-point above `w`".

**What this file proves.**  PLL is sound and complete for subframe models, by
two translations that route through the existing constraint-model theorems
rather than a new canonical model (Matthew's suggestion, 2026-10-14):

* `SubframeModel.toConstraint` — every subframe model is a constraint model
  with the same forcing on its points: add one fallible top; make each
  `S`-point rigid (`Rₘ`-successors: itself); give every other point the
  fallible top as an `Rₘ`-successor.  The `∀∃` clause then says exactly "every
  `S`-point above forces `φ`" (`toConstraint_force`).  Soundness follows from
  `soundness`.
* `ConstraintModel.toSubframe` — every FINITE constraint model is a subframe
  model with the same forcing on its non-fallible worlds: drop the fallible
  worlds and take `S` to be the `Rₘ`-final worlds, those all of whose
  `Rₘ`-successors reach them back (`toSubframe_force`).  On a finite model every
  world has an `Rₘ`-final `Rₘ`-successor (`exists_rmFinal`), which is what the
  `∃` of the `∀∃` clause can always be pushed to.  Completeness follows from the
  finite model property (`not_provable_iff_exists_finite_countermodel`).

For infinite constraint models no such point set need exist (an `Rₘ`-chain may
have no final element); completeness does not need them.

**Why it is here.**  It is the first gate of the proposal in
`docs/semui-amalgamation-2026-10-14.md` §6: run the semantic route to uniform
interpolation in a semantics where `◯` is a universal modality over one
relation and there are no fallible worlds, so that bounded bisimulation and
agreement on formulas can coincide.  If PLL were incomplete for these models
the route would prove uniform interpolation for the wrong logic.
-/

open PLLFormula

namespace PLLND

/-- A subframe model: a preorder, a hereditary valuation, and a set `S` of
points at which `◯` is evaluated. -/
structure SubframeModel where
  W : Type
  le : W → W → Prop
  S : Set W
  V : String → Set W
  refl : ∀ w, le w w
  trans : ∀ {u v w}, le u v → le v w → le u w
  hered : ∀ {a : String} {u v}, le u v → u ∈ V a → v ∈ V a

namespace SubframeModel

/-- Forcing.  `⊥` holds nowhere; `◯φ` holds at `x` when `φ` holds at every
`S`-point above `x`. -/
def force (M : SubframeModel) : M.W → PLLFormula → Prop
  | w, .prop a     => w ∈ M.V a
  | _, .falsePLL   => False
  | w, .and φ ψ    => M.force w φ ∧ M.force w ψ
  | w, .or φ ψ     => M.force w φ ∨ M.force w ψ
  | w, .ifThen φ ψ => ∀ v, M.le w v → M.force v φ → M.force v ψ
  | w, .somehow φ  => ∀ v, M.le w v → v ∈ M.S → M.force v φ

/-! ## Subframe models are constraint models -/

/-- Points of the translated model: the old points, and one fallible top. -/
def toConstraintRi (M : SubframeModel) : Option M.W → Option M.W → Prop
  | some x, some y => M.le x y
  | _, none => True
  | none, some _ => False

/-- `Rₘ`: an `S`-point sees only itself; any other point sees itself and the
fallible top. -/
def toConstraintRm (M : SubframeModel) : Option M.W → Option M.W → Prop
  | some x, some y => x = y
  | some x, none => x ∉ M.S
  | none, some _ => False
  | none, none => True

/-- **The translation.**  Add a fallible top, make the `S`-points rigid and
let every other point see the fallible top along `Rₘ`. -/
def toConstraint (M : SubframeModel) : ConstraintModel where
  W := Option M.W
  Ri := M.toConstraintRi
  Rm := M.toConstraintRm
  F := {a | a = none}
  V := fun x a => match a with
    | some w => w ∈ M.V x
    | none => True
  refl_i := by
    intro a
    cases a with
    | some x => exact M.refl x
    | none => trivial
  trans_i := by
    intro a b c h₁ h₂
    cases a <;> cases b <;> cases c <;>
      first
      | trivial
      | exact M.trans h₁ h₂
  refl_m := by
    intro a
    cases a with
    | some x => rfl
    | none => trivial
  trans_m := by
    intro a b c h₁ h₂
    cases a with
    | none =>
        cases b with
        | some _ => exact h₁.elim
        | none => exact h₂
    | some x =>
        cases b with
        | none =>
            cases c with
            | some _ => exact h₂.elim
            | none => exact h₁
        | some y =>
            have hxy : x = y := h₁
            subst hxy
            exact h₂
  sub_mi := by
    intro a b h
    cases a with
    | none =>
        cases b with
        | some _ => exact h.elim
        | none => trivial
    | some x =>
        cases b with
        | none => trivial
        | some y =>
            have hxy : x = y := h
            subst hxy
            exact M.refl x
  hered_F := by
    intro a b h hF
    have ha : a = none := hF
    subst ha
    cases b with
    | some _ => exact h.elim
    | none => rfl
  hered_V := by
    intro x a b h hv
    cases a with
    | none =>
        cases b with
        | some _ => exact h.elim
        | none => trivial
    | some u =>
        cases b with
        | none => trivial
        | some v => exact M.hered h hv
  full_F := by
    intro x a hF
    have ha : a = none := hF
    subst ha
    trivial

/-- **The translation preserves forcing on the old points.** -/
theorem toConstraint_force (M : SubframeModel) :
    ∀ (φ : PLLFormula) (x : M.W),
      ((toConstraint M).force (some x) φ ↔ M.force x φ) := by
  intro φ
  induction φ with
  | prop a => intro x; exact Iff.rfl
  | falsePLL =>
      intro x
      constructor
      · intro h
        exact absurd (show (some x : Option M.W) = none from h) (by simp)
      · intro h
        exact h.elim
  | and φ ψ ihφ ihψ =>
      intro x
      exact and_congr (ihφ x) (ihψ x)
  | or φ ψ ihφ ihψ =>
      intro x
      exact or_congr (ihφ x) (ihψ x)
  | ifThen φ ψ ihφ ihψ =>
      intro x
      constructor
      · intro h v hxv hφ
        exact (ihψ v).mp (h (some v) hxv ((ihφ v).mpr hφ))
      · intro h b hxb hφ
        cases b with
        | none => exact (toConstraint M).force_of_fallible rfl
        | some v => exact (ihψ v).mpr (h v hxb ((ihφ v).mp hφ))
  | somehow φ ih =>
      intro x
      constructor
      · intro h v hxv hvS
        obtain ⟨u, hvu, hu⟩ := h (some v) hxv
        cases u with
        | none => exact absurd hvS hvu
        | some u' =>
            have hvu' : v = u' := hvu
            subst hvu'
            exact (ih v).mp hu
      · intro h b hxb
        cases b with
        | none => exact ⟨none, trivial, (toConstraint M).force_of_fallible rfl⟩
        | some v =>
            by_cases hvS : v ∈ M.S
            · exact ⟨some v, rfl, (ih v).mpr (h v hxb hvS)⟩
            · exact ⟨none, hvS, (toConstraint M).force_of_fallible rfl⟩

/-- **Soundness for subframe models**, through the constraint-model
translation and the existing `soundness`. -/
theorem soundness {Γ : List PLLFormula} {φ : PLLFormula} (p : Γ ⊢ φ)
    (M : SubframeModel) (x : M.W) (hΓ : ∀ χ ∈ Γ, M.force x χ) :
    M.force x φ :=
  (toConstraint_force M φ x).mp
    (PLLND.soundness p (toConstraint M) (some x)
      (fun χ hχ => (toConstraint_force M χ x).mpr (hΓ χ hχ)))

end SubframeModel

/-! ## Finite constraint models are subframe models -/

namespace ConstraintModel

/-- `z` is `Rₘ`-final: every `Rₘ`-successor of `z` reaches `z` back. -/
def RmFinal (C : ConstraintModel) (z : C.W) : Prop :=
  ∀ u, C.Rm z u → C.Rm u z

/-- **On a finite model every world has an `Rₘ`-final `Rₘ`-successor**: the
`Rₘ`-successor sets shrink strictly along a step that cannot be reversed. -/
theorem exists_rmFinal (C : ConstraintModel) [Finite C.W] :
    ∀ v : C.W, ∃ z, C.Rm v z ∧ C.RmFinal z := by
  classical
  intro v
  induction h : {u | C.Rm v u}.ncard using Nat.strong_induction_on generalizing v with
  | _ n ih =>
    by_cases hf : C.RmFinal v
    · exact ⟨v, C.refl_m v, hf⟩
    · have hex : ∃ u, C.Rm v u ∧ ¬ C.Rm u v := by
        by_contra hc
        exact hf fun u hu => by
          by_contra hn
          exact hc ⟨u, hu, hn⟩
      obtain ⟨u, hvu, huv⟩ := hex
      have hlt : {w | C.Rm u w}.ncard < n := by
        rw [← h]
        apply Set.ncard_lt_ncard _ (Set.toFinite _)
        refine Set.ssubset_iff_subset_ne.mpr ⟨fun w hw => C.trans_m hvu hw, ?_⟩
        intro hEq
        have hv : v ∈ {w | C.Rm v w} := C.refl_m v
        rw [← hEq] at hv
        exact huv hv
      obtain ⟨z, huz, hz⟩ := ih _ hlt u rfl
      exact ⟨z, C.trans_m hvu huz, hz⟩

/-- **The translation**: the non-fallible worlds, ordered by `Rᵢ`, with `S` the
`Rₘ`-final ones. -/
def toSubframe (C : ConstraintModel) : SubframeModel where
  W := {w : C.W // w ∉ C.F}
  le := fun a b => C.Ri a.1 b.1
  S := {a | C.RmFinal a.1}
  V := fun x a => a.1 ∈ C.V x
  refl := fun a => C.refl_i a.1
  trans := fun h₁ h₂ => C.trans_i h₁ h₂
  hered := fun h hv => C.hered_V h hv

/-- **The translation preserves forcing at non-fallible worlds** of a finite
model. -/
theorem toSubframe_force (C : ConstraintModel) [Finite C.W] :
    ∀ (φ : PLLFormula) (a : C.toSubframe.W),
      (C.force a.1 φ ↔ C.toSubframe.force a φ) := by
  intro φ
  induction φ with
  | prop x => intro a; exact Iff.rfl
  | falsePLL =>
      intro a
      exact iff_of_false a.2 (fun h => h)
  | and φ ψ ihφ ihψ =>
      intro a
      exact and_congr (ihφ a) (ihψ a)
  | or φ ψ ihφ ihψ =>
      intro a
      exact or_congr (ihφ a) (ihψ a)
  | ifThen φ ψ ihφ ihψ =>
      intro a
      constructor
      · intro h b hab hφ
        exact (ihψ b).mp (h b.1 hab ((ihφ b).mpr hφ))
      · intro h v hav hφ
        by_cases hvF : v ∈ C.F
        · exact C.force_of_fallible hvF
        · exact (ihψ ⟨v, hvF⟩).mpr
            (h ⟨v, hvF⟩ hav ((ihφ ⟨v, hvF⟩).mp hφ))
  | somehow φ ih =>
      intro a
      constructor
      · -- an `Rₘ`-final point is its own witness's `Rᵢ`-successor
        intro h b hab hbS
        obtain ⟨u, hbu, hu⟩ := h b.1 hab
        exact (ih b).mp (C.force_hered (C.sub_mi (hbS u hbu)) hu)
      · -- push the witness to an `Rₘ`-final `Rₘ`-successor
        intro h v hav
        obtain ⟨z, hvz, hz⟩ := C.exists_rmFinal v
        by_cases hzF : z ∈ C.F
        · exact ⟨z, hvz, C.force_of_fallible hzF⟩
        · exact ⟨z, hvz, (ih ⟨z, hzF⟩).mpr
            (h ⟨z, hzF⟩ (C.trans_i hav (C.sub_mi hvz)) hz)⟩

end ConstraintModel

namespace SubframeModel

/-- **Completeness for subframe models**: a formula forced at every point of
every subframe model is a theorem.  Through the finite model property: a
non-theorem has a finite constraint countermodel, its refuting world is not
fallible, and `toSubframe` keeps the refutation. -/
theorem completeness {φ : PLLFormula}
    (h : ∀ (M : SubframeModel) (x : M.W), M.force x φ) :
    Nonempty ([] ⊢ φ) := by
  by_contra hn
  obtain ⟨C, hfin, w, hw⟩ := not_provable_iff_exists_finite_countermodel.mp hn
  have hwF : w ∉ C.F := fun hF => hw (C.force_of_fallible hF)
  exact hw ((C.toSubframe_force φ ⟨w, hwF⟩).mpr (h C.toSubframe ⟨w, hwF⟩))

/-- **PLL is the logic of subframe models.** -/
theorem derivable_iff_valid {φ : PLLFormula} :
    Nonempty ([] ⊢ φ) ↔ ∀ (M : SubframeModel) (x : M.W), M.force x φ :=
  ⟨fun ⟨p⟩ M x => soundness p M x (by simp), completeness⟩

end SubframeModel

