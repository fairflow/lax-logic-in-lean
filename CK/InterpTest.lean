import CK.UniformInterpolation

/-!
# `CK.InterpTest` — the Lean interpolants against Rocq's

The twenty-two values below were computed by the Rocq development of
van der Giessen and Shillito (`github.com/ianshil/CK`, branch
`uniform_interpolation`, commit `cd09fce`): `Ef 0 φ` and `Af 0 φ`, extracted
to OCaml (`Extraction "ef.ml" Ef Af`) and printed.  `CK.Ef` and `CK.Af` must
print the same strings: the test is of the transcription of Figure 3, row by
row and in Rocq's order.  `p`, `q` are the variables `0`, `1`.
-/

namespace CK

open scoped Form

/-- The printer used on the OCaml side. -/
def pp : Form → String
  | .var 0 => "p"
  | .var 1 => "q"
  | .var 2 => "r"
  | .var (n + 3) => "x" ++ toString (n + 3)
  | .bot => "⊥"
  | .and a b => "(" ++ pp a ++ " ∧ " ++ pp b ++ ")"
  | .or a b => "(" ++ pp a ++ " ∨ " ++ pp b ++ ")"
  | .imp a b => "(" ++ pp a ++ " → " ++ pp b ++ ")"
  | .box a => "□" ++ pp a
  | .dia a => "◇" ++ pp a

private def p : Form := .var 0
private def q : Form := .var 1
private def r : Form := .var 2

#guard pp (Ef 0 (p)) == "(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 (p ⋏ q)) == "(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))))))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 (p ⋎ q)) == "(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∨ (□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 (p ⟶ q)) == "(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 (□p)) == "(□(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ (□(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 (◇p)) == "(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (◇(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 ((◇p) ⋏ ((◇p) ⟶ q))) == "(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((◇(((⊥ → ⊥) ∧ (⊥ → ⊥)) → (⊥ ∨ ⊥)) → (□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ (◇(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))))))) ∧ (◇(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ ((□((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) → (⊥ ∨ ((⊥ → ⊥) ∨ (⊥ ∨ (⊥ ∨ ⊥))))) → (□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ (◇(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))))))) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))))))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Ef 0 (□(p ⋎ q))) == "(□(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∨ (□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ (□(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∨ (□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥))))"

#guard pp (Af 0 (p)) == "(⊥ ∨ ⊥)"

#guard pp (Af 0 (p ⟶ q)) == "(((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) → (q ∨ (⊥ ∨ (⊥ ∨ (⊥ ∨ ⊥))))) ∨ ⊥)"

#guard pp (Af 0 (q ⟶ p)) == "(((□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ (q ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) → (⊥ ∨ (⊥ ∨ (⊥ ∨ (⊥ ∨ ⊥))))) ∨ ⊥)"

#guard pp (Af 0 (□p)) == "(□(((⊥ → ⊥) ∧ (⊥ → ⊥)) → (⊥ ∨ ⊥)) ∨ ⊥)"

#guard pp (Af 0 (◇p)) == "(◇(((⊥ → ⊥) ∧ (⊥ → ⊥)) → (⊥ ∨ ⊥)) ∨ ⊥)"

#guard pp (Af 0 (◇(p ⋎ q))) == "(◇(((⊥ → ⊥) ∧ (⊥ → ⊥)) → (((⊥ ∨ ⊥) ∨ (q ∨ ⊥)) ∨ ⊥)) ∨ ⊥)"

#guard pp (Af 0 ((□p) ⟶ q)) == "(((□(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ (□(□((⊥ → ⊥) ∧ (⊥ → ⊥)) ∧ ((⊥ → ⊥) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) ∧ ((⊥ → ⊥) ∧ (⊥ → ⊥)))) → (q ∨ (⊥ ∨ (⊥ ∨ (⊥ ∨ ⊥))))) ∨ ⊥)"

