/-! A use of the theorem, as a check that its hypotheses can be met:
`(p → q) ∧ p ⇒ q` and `q` is without `p`, so `∃p ((p → q) ∧ p) ⇒ q`. -/

example : G4CK [Ef 0 ((p ⟶ q) ⋏ p)] q :=
  (G4CK_uniform_interpolation 0 [1] (by decide) ((p ⟶ q) ⋏ p)
    (by intro x hx
        simp only [Form.Occurs, p, q] at hx
        rcases hx with (rfl | rfl) | rfl <;> decide)).2.2.1 q
    (by intro x hx
        simp only [Form.Occurs, q] at hx
        subst hx; decide)
    (.andL (List.Perm.refl _) (.impVarL (List.Perm.refl _) List.mem_cons_self
      (.idP List.mem_cons_self)))

end CK
